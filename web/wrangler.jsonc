// Publicación en Cloudflare Workers (archivos estáticos del panel).
// "name" debe coincidir con el nombre del Worker en el panel de Cloudflare.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nexot-v2",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    // Cualquier ruta (/registrar, /personas…) devuelve el panel
    "not_found_handling": "single-page-application"
  }
}
